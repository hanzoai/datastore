FROM ubuntu:22.04

# see https://github.com/moby/moby/issues/4032#issuecomment-192327844
ARG DEBIAN_FRONTEND=noninteractive

# ARG for quick switch to a given ubuntu mirror
ARG apt_archive="http://archive.ubuntu.com"

# We shouldn't use `apt upgrade` to not change the upstream image. It's updated biweekly

# user/group precreated explicitly with fixed uid/gid (101) on purpose, as upstream.
# Important for rootless containers: the entrypoint can't chown, so owners of mounted
# volumes are configured externally. Done before any package install so unrelated
# software can't pick that uid/gid.
RUN sed -i "s|http://archive.ubuntu.com|${apt_archive}|g" /etc/apt/sources.list \
    && groupadd -r hanzo-datastore --gid=101 \
    && useradd -r -g hanzo-datastore --uid=101 --home-dir=/var/lib/hanzo-datastore --shell=/bin/bash hanzo-datastore \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        busybox \
        ca-certificates \
        locales \
        tzdata \
        wget \
    && busybox --install -s \
    && rm -rf /var/lib/apt/lists/* /var/cache/debconf /tmp/*

ARG VERSION="26.5.3.1"
ARG PACKAGES="hanzo-datastore-client hanzo-datastore-server hanzo-datastore-common-static"
ARG TARGETARCH

# The hanzo-datastore packages come from our own from-source build: the CI build job
# compiles the binary and nfpm-packages the debs from packages/hanzo-datastore-*.yaml,
# then this image installs them via one of the locations below. There is NO upstream
# package-repository fallback — this image ships our binary, never a redistributed
# clickhouse package.

# Number of `wget` retries and delay between them, for resilience against transient
# HTTP errors from the build artifact store.
ARG WGET_RETRIES=5
ARG WGET_RETRY_DELAY=1

# (a) install from explicit deb URLs — CI passes one URL per package
ARG DIRECT_DOWNLOAD_URLS=""
RUN wget_with_retry() { \
        local attempt=1; \
        while [ "$attempt" -le "${WGET_RETRIES}" ]; do \
            if wget --progress=bar:force:noscroll "$@"; then return 0; fi; \
            echo "Attempt $attempt/${WGET_RETRIES} failed, retrying in ${WGET_RETRY_DELAY}s..."; \
            sleep "${WGET_RETRY_DELAY}"; \
            attempt=$((attempt + 1)); \
        done; \
        echo "ERROR: Failed to download after ${WGET_RETRIES} attempts"; return 1; \
    } \
    && if [ -n "${DIRECT_DOWNLOAD_URLS}" ]; then \
        echo "installing from explicit deb urls: ${DIRECT_DOWNLOAD_URLS}" \
        && rm -rf /tmp/datastore_debs && mkdir -p /tmp/datastore_debs \
        && for url in $DIRECT_DOWNLOAD_URLS; do \
            wget_with_retry "$url" -P /tmp/datastore_debs || exit 1 \
        ; done \
        && dpkg -i /tmp/datastore_debs/*.deb \
        && rm -rf /tmp/* ; \
    fi

# (b) install from a web location holding the deb packages — CI passes a base URL
ARG deb_location_url=""
RUN arch="${TARGETARCH:-amd64}" \
    && if [ -n "${deb_location_url}" ]; then \
        echo "installing from deb location: ${deb_location_url}" \
        && rm -rf /tmp/datastore_debs && mkdir -p /tmp/datastore_debs \
        && for package in ${PACKAGES}; do \
            { wget --progress=bar:force:noscroll "${deb_location_url}/${package}_${VERSION}_${arch}.deb" -P /tmp/datastore_debs || \
              wget --progress=bar:force:noscroll "${deb_location_url}/${package}_${VERSION}_all.deb" -P /tmp/datastore_debs ; } \
            || exit 1 \
        ; done \
        && dpkg -i /tmp/datastore_debs/*.deb \
        && rm -rf /tmp/* ; \
    fi

# (c) install from a single multi-call binary — sanitizer / non-standard builds
ARG single_binary_location_url=""
RUN if [ -n "${single_binary_location_url}" ]; then \
        echo "installing from single binary url: ${single_binary_location_url}" \
        && rm -rf /tmp/datastore_binary && mkdir -p /tmp/datastore_binary \
        && wget --progress=bar:force:noscroll "${single_binary_location_url}" -O /tmp/datastore_binary/hanzo-datastore \
        && chmod +x /tmp/datastore_binary/hanzo-datastore \
        && /tmp/datastore_binary/hanzo-datastore install --user hanzo-datastore --group hanzo-datastore \
        && rm -rf /tmp/* ; \
    fi

# fail fast if no install location produced a binary — there is no silent fallback to
# an upstream package repository.
RUN hanzo-datastore local -q 'SELECT 1' >/dev/null 2>&1 \
    || { echo "ERROR: no hanzo-datastore binary installed — pass DIRECT_DOWNLOAD_URLS, deb_location_url, or single_binary_location_url (the CI build provides these)."; exit 1; }

# post install
# allow "others" access to the data/config dirs, because the container can be started
# with an arbitrary uid (openshift usecase)
RUN hanzo-datastore local -q 'SELECT * FROM system.build_options' \
    && mkdir -p /var/lib/hanzo-datastore /var/log/hanzo-datastore-server /etc/hanzo-datastore-server /etc/hanzo-datastore-client \
    && chmod ugo+Xrw -R /var/lib/hanzo-datastore /var/log/hanzo-datastore-server /etc/hanzo-datastore-server /etc/hanzo-datastore-client

RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV TZ=UTC

RUN mkdir /docker-entrypoint-initdb.d

COPY docker_related_config.xml /etc/hanzo-datastore-server/config.d/
COPY hanzo-paths.xml           /etc/hanzo-datastore-server/config.d/
COPY datastore-port-override.xml /etc/hanzo-datastore-server/config.d/
COPY entrypoint.sh /entrypoint.sh

EXPOSE 9000 8123 9009
VOLUME /var/lib/hanzo-datastore

ENV HANZO_CONFIG=/etc/hanzo-datastore-server/config.xml

ENTRYPOINT ["/entrypoint.sh"]
