<datastore>
    <!-- Override upstream paths for Hanzo Datastore white-label -->
    <path>/var/lib/hanzo-datastore/</path>
    <tmp_path>/var/lib/hanzo-datastore/tmp/</tmp_path>
    <user_files_path>/var/lib/hanzo-datastore/user_files/</user_files_path>
    <format_schema_path>/var/lib/hanzo-datastore/format_schemas/</format_schema_path>
    <custom_cached_disks_base_directory>/var/lib/hanzo-datastore/caches/</custom_cached_disks_base_directory>

    <logger>
        <log>/var/log/hanzo-datastore-server/hanzo-datastore-server.log</log>
        <errorlog>/var/log/hanzo-datastore-server/hanzo-datastore-server.err.log</errorlog>
    </logger>

    <user_directories>
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <local_directory>
            <path>/var/lib/hanzo-datastore/access/</path>
        </local_directory>
    </user_directories>
</datastore>
