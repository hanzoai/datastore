# Distroless Datastore server image.
# Contains no shell, no package manager, no coreutils.
# The entrypoint is the compiled `datastore docker-init` subcommand.
#
# Build targets:
#   production  — ghcr.io/hanzoai/debian13:cc-nonroot  (default)
#   debug       — ghcr.io/hanzoai/debian13:cc-debug-nonroot  (includes busybox shell)
#
# Usage:
#   docker build -f Dockerfile.distroless --target production -t datastore/datastore-server:distroless .
#   docker build -f Dockerfile.distroless --target debug     -t datastore/datastore-server:distroless-debug .

# ──────────────────────────────────────────────────────────────────────────────
# Stage 1: Install Datastore and assemble the output directory tree.
# ──────────────────────────────────────────────────────────────────────────────
FROM ubuntu:22.04 AS ch-builder

# see https://github.com/moby/moby/issues/4032#issuecomment-192327844
ARG DEBIAN_FRONTEND=noninteractive

ARG apt_archive="http://archive.ubuntu.com"

# user/group precreated explicitly with fixed uid/gid on purpose.
# It is especially important for rootless containers: in that case entrypoint
# can't do chown and owners of mounted volumes should be configured externally.
# We do that in advance at the beginning of Dockerfile before any packages will be
# installed to prevent picking those uid/gid by some unrelated software.
# The same uid/gid (101) is used both for alpine and ubuntu.
RUN sed -i "s|http://archive.ubuntu.com|${apt_archive}|g" /etc/apt/sources.list \
    && groupadd -r datastore --gid=101 \
    && useradd -r -g datastore --uid=101 --home-dir=/var/lib/datastore --shell=/bin/bash datastore \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        wget \
    && rm -rf /var/lib/apt/lists/* /var/cache/debconf /tmp/*

ARG REPO_CHANNEL="stable"
ARG REPOSITORY="deb [signed-by=/usr/share/keyrings/datastore-keyring.gpg] https://packages.datastore.com/deb ${REPO_CHANNEL} main"
ARG VERSION="26.3.9.8"
ARG PACKAGES="datastore-client datastore-server datastore-common-static"

#docker-official-library:off
ARG deb_location_url=""
ARG DIRECT_DOWNLOAD_URLS=""
ARG single_binary_location_url=""
ARG TARGETARCH

# Install from direct URLs (deb packages provided by CI).
RUN if [ -n "${DIRECT_DOWNLOAD_URLS}" ]; then \
        rm -rf /tmp/clickhouse_debs \
        && mkdir -p /tmp/clickhouse_debs \
        && for url in $DIRECT_DOWNLOAD_URLS; do \
            wget --progress=bar:force:noscroll "$url" -P /tmp/clickhouse_debs || exit 1 \
        ; done \
        && dpkg -i /tmp/clickhouse_debs/*.deb \
        && rm -rf /tmp/* ; \
    fi

# Install from a web location with deb packages.
RUN arch="${TARGETARCH:-amd64}" \
    && if [ -n "${deb_location_url}" ]; then \
        rm -rf /tmp/clickhouse_debs \
        && mkdir -p /tmp/clickhouse_debs \
        && for package in ${PACKAGES}; do \
            { wget --progress=bar:force:noscroll "${deb_location_url}/${package}_${VERSION}_${arch}.deb" -P /tmp/clickhouse_debs || \
              wget --progress=bar:force:noscroll "${deb_location_url}/${package}_${VERSION}_all.deb" -P /tmp/clickhouse_debs ; } \
            || exit 1 \
        ; done \
        && dpkg -i /tmp/clickhouse_debs/*.deb \
        && rm -rf /tmp/* ; \
    fi

# Install from a single binary.
RUN if [ -n "${single_binary_location_url}" ]; then \
        rm -rf /tmp/clickhouse_binary \
        && mkdir -p /tmp/clickhouse_binary \
        && wget --progress=bar:force:noscroll "${single_binary_location_url}" -O /tmp/clickhouse_binary/datastore \
        && chmod +x /tmp/clickhouse_binary/datastore \
        && /tmp/clickhouse_binary/datastore install --user "datastore" --group "datastore" \
        && rm -rf /tmp/* ; \
    fi

# Fall back to installation from the Datastore repository.
RUN datastore local -q 'SELECT 1' >/dev/null 2>&1 && exit 0 || : \
    ; apt-get update \
    && apt-get install --yes --no-install-recommends dirmngr gnupg2 \
    && mkdir -p /etc/apt/sources.list.d \
    && GNUPGHOME=$(mktemp -d) \
    && ( set +e; \
        for KEYSERVER in \
            hkp://keys.openpgp.org:80 \
            hkp://pgp.mit.edu:80 \
            hkp://keyserver.ubuntu.com:80; do \
            GNUPGHOME="$GNUPGHOME" gpg --batch --no-default-keyring \
                --keyring /usr/share/keyrings/datastore-keyring.gpg \
                --keyserver "$KEYSERVER" \
                --recv-keys 3a9ea1193a97b548be1457d48919f6bd2b48d754 && break; \
        done || exit 1 \
    ) \
    && rm -rf "$GNUPGHOME" \
    && chmod +r /usr/share/keyrings/datastore-keyring.gpg \
    && echo "${REPOSITORY}" > /etc/apt/sources.list.d/datastore.list \
    && echo "installing from repository: ${REPOSITORY}" \
    && apt-get update \
    && for package in ${PACKAGES}; do \
        packages="${packages} ${package}=${VERSION}" \
    ; done \
    && apt-get install --yes --no-install-recommends ${packages} \
    && rm -rf /var/lib/apt/lists/* /var/cache/debconf /tmp/* \
    && apt-get autoremove --purge -yq dirmngr gnupg2

#docker-official-library:on

# Verify the installation.
RUN datastore-local -q 'SELECT * FROM system.build_options'

# Assemble the output directory tree that will be COPYed into the distroless image.
# Symlinks pointing to /usr/bin/datastore are preserved by Docker COPY.
RUN mkdir -p \
        /output/usr/bin \
        /output/etc/datastore-server/config.d \
        /output/etc/datastore-server/users.d \
        /output/etc/datastore-client \
        /output/var/lib/datastore \
        /output/var/log/datastore-server \
        /output/docker-entrypoint-initdb.d \
        /output/tmp \
    && cp /usr/bin/datastore /output/usr/bin/datastore \
    && for link in datastore-server datastore-client datastore-local \
                   datastore-keeper datastore-keeper-client \
                   datastore-docker-init; do \
        ln -sf /usr/bin/datastore "/output/usr/bin/${link}" ; \
    done \
    && cp -r /etc/datastore-server/. /output/etc/datastore-server/ \
    && if [ -d /etc/datastore-client ]; then cp -r /etc/datastore-client/. /output/etc/datastore-client/; fi

COPY docker_related_config.xml /output/etc/datastore-server/config.d/

# Set ownership after all config files are in place (including docker_related_config.xml above).
RUN chown -R datastore:datastore \
        /output/etc/datastore-server \
        /output/var/lib/datastore \
        /output/var/log/datastore-server \
        /output/docker-entrypoint-initdb.d \
    && chmod 1777 /output/tmp

# Create /etc/passwd and /etc/group that include the datastore user (uid/gid 101).
# These entries are merged with the distroless base's existing entries.
RUN { \
        printf 'root:x:0:0:root:/root:/sbin/nologin\n'; \
        printf 'nobody:x:65534:65534:nobody:/nonexistent:/sbin/nologin\n'; \
        printf 'nonroot:x:65532:65532:nonroot:/home/nonroot:/sbin/nologin\n'; \
        printf 'datastore:x:101:101:Datastore:/var/lib/datastore:/sbin/nologin\n'; \
    } > /output/etc/passwd \
    && { \
        printf 'root:x:0:\n'; \
        printf 'nobody:x:65534:\n'; \
        printf 'nonroot:x:65532:\n'; \
        printf 'datastore:x:101:\n'; \
    } > /output/etc/group

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2: Production distroless image.
# ──────────────────────────────────────────────────────────────────────────────
# Hanzo-mirrored cc-debian13 (distroless equivalent). SHA digest preserved
# verbatim from the upstream pin so the build remains bit-reproducible.
# Pinned 2026-04-02.
FROM ghcr.io/hanzoai/debian13:cc-nonroot@sha256:9c4fe2381c2e6d53c4cfdefeff6edbd2a67ec7713e2c3ca6653806cbdbf27a1e AS production

COPY --from=ch-builder /output/ /

ENV DATASTORE_CONFIG=/etc/datastore-server/config.xml \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    DATASTORE_WATCHDOG_ENABLE=0

EXPOSE 9000 8123 9009

VOLUME ["/var/lib/datastore", "/var/log/datastore-server"]

USER 101:101
WORKDIR /var/lib/datastore

ENTRYPOINT ["/usr/bin/datastore", "docker-init"]

# ──────────────────────────────────────────────────────────────────────────────
# Stage 3: Debug image — same as production but includes the busybox shell
#           at /busybox/sh for interactive troubleshooting.
# ──────────────────────────────────────────────────────────────────────────────
# Pinned 2026-04-02. SHA digest preserved verbatim from the upstream pin.
FROM ghcr.io/hanzoai/debian13:cc-debug-nonroot@sha256:d47b319b1047dff7cdee335e3e61468f3610fac20060653aabe3786d6ecba621 AS debug

COPY --from=ch-builder /output/ /

ENV DATASTORE_CONFIG=/etc/datastore-server/config.xml \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    DATASTORE_WATCHDOG_ENABLE=0

EXPOSE 9000 8123 9009

VOLUME ["/var/lib/datastore", "/var/log/datastore-server"]

USER 101:101
WORKDIR /var/lib/datastore

ENTRYPOINT ["/usr/bin/datastore", "docker-init"]

# TODO(ghcr-auth): CI workflows building this image must `docker login`
# to ghcr.io/hanzoai with a PAT (secret: GHCR_PULL_TOKEN) — the default
# GITHUB_TOKEN scopes to the repo's own package only.
