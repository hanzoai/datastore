<datastore>
    <!-- Override upstream paths for Hanzo Datastore white-label -->
    <path>/var/lib/datastore/</path>
    <tmp_path>/var/lib/datastore/tmp/</tmp_path>
    <user_files_path>/var/lib/datastore/user_files/</user_files_path>
    <format_schema_path>/var/lib/datastore/format_schemas/</format_schema_path>
    <custom_cached_disks_base_directory>/var/lib/datastore/caches/</custom_cached_disks_base_directory>

    <logger>
        <log>/var/log/datastore-server/datastore-server.log</log>
        <errorlog>/var/log/datastore-server/datastore-server.err.log</errorlog>
    </logger>

    <user_directories>
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <local_directory>
            <path>/var/lib/datastore/access/</path>
        </local_directory>
    </user_directories>
</datastore>
