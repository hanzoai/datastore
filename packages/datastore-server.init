#!/bin/sh
### BEGIN INIT INFO
# Provides:          datastore-server
# Required-Start:    $network
# Required-Stop:     $network
# Should-Start:      $time
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: datastore-server daemon
### END INIT INFO
#
# NOTES:
# - Should-* -- script can start if the listed facilities are missing, unlike Required-*
#
# For the documentation [1]:
#
#   [1]: https://wiki.debian.org/LSBInitScripts

DATASTORE_USER=datastore
DATASTORE_GROUP=${DATASTORE_USER}
SHELL=/bin/bash
PROGRAM=datastore-server
DATASTORE_GENERIC_PROGRAM=datastore
DATASTORE_PROGRAM_ENV=""
EXTRACT_FROM_CONFIG=${DATASTORE_GENERIC_PROGRAM}-extract-from-config
DATASTORE_CONFDIR=/etc/$PROGRAM
DATASTORE_LOGDIR=/var/log/datastore-server
DATASTORE_LOGDIR_USER=root
DATASTORE_DATADIR=/var/lib/datastore
if [ -d "/var/lock" ]; then
    LOCALSTATEDIR=/var/lock
else
    LOCALSTATEDIR=/run/lock
fi

if [ ! -d "$LOCALSTATEDIR" ]; then
    mkdir -p "$LOCALSTATEDIR"
fi

DATASTORE_BINDIR=/usr/bin
DATASTORE_CRONFILE=/etc/cron.d/datastore-server
DATASTORE_CONFIG=$DATASTORE_CONFDIR/config.xml
LOCKFILE=$LOCALSTATEDIR/$PROGRAM
DATASTORE_PIDDIR=/var/run/$PROGRAM
DATASTORE_PIDFILE="$DATASTORE_PIDDIR/$PROGRAM.pid"
# DATASTORE_STOP_TIMEOUT=60 # Disabled by default. Place to /etc/default/datastore if you need.

# Some systems lack "flock"
command -v flock >/dev/null && FLOCK=flock

# Override defaults from optional config file and export them automatically
set -a
test -f /etc/default/datastore && . /etc/default/datastore
set +a

die()
{
    echo $1 >&2
    exit 1
}


# Check that configuration file is Ok.
check_config()
{
    if [ -x "$DATASTORE_BINDIR/$EXTRACT_FROM_CONFIG" ]; then
        su -s $SHELL ${DATASTORE_USER} -c "$DATASTORE_BINDIR/$EXTRACT_FROM_CONFIG --config-file=\"$DATASTORE_CONFIG\" --key=path" >/dev/null || die "Configuration file ${DATASTORE_CONFIG} doesn't parse successfully. Won't restart server. You may use forcerestart if you are sure.";
    fi
}


initdb()
{
    ${DATASTORE_GENERIC_PROGRAM} install --user "${DATASTORE_USER}" --pid-path "${DATASTORE_PIDDIR}" --config-path "${DATASTORE_CONFDIR}" --binary-path "${DATASTORE_BINDIR}"
}


start()
{
    ${DATASTORE_GENERIC_PROGRAM} start --user "${DATASTORE_USER}" --pid-path "${DATASTORE_PIDDIR}" --config-path "${DATASTORE_CONFDIR}" --binary-path "${DATASTORE_BINDIR}"
}


stop()
{
    ${DATASTORE_GENERIC_PROGRAM} stop --pid-path "${DATASTORE_PIDDIR}"
}


restart()
{
    ${DATASTORE_GENERIC_PROGRAM} restart --user "${DATASTORE_USER}" --pid-path "${DATASTORE_PIDDIR}" --config-path "${DATASTORE_CONFDIR}" --binary-path "${DATASTORE_BINDIR}"
}


forcestop()
{
    ${DATASTORE_GENERIC_PROGRAM} stop --force --pid-path "${DATASTORE_PIDDIR}"
}


service_or_func()
{
    if [ -n "${SYSTEMCTL_SKIP_REDIRECT+x}" ]; then
        $1
        return
    fi

    if [ -x "/bin/systemctl" ] && [ -d /run/systemd/system ]; then
        if [ -f /etc/systemd/system/datastore-server.service ] || [ -f /lib/systemd/system/datastore-server.service ]; then
            systemctl $1 $PROGRAM
            return
        fi
    fi

    $1
}

forcerestart()
{
    forcestop
    # Should not use 'start' function if systemd active
    service_or_func start
}

use_cron()
{
    # 1. running systemd
    if [ -x "/bin/systemctl" ] && [ -f /etc/systemd/system/datastore-server.service ] && [ -d /run/systemd/system ]; then
        return 1
    fi
    # 2. checking whether the config is existed
    if [ ! -f "$DATASTORE_CRONFILE" ]; then
        return 1
    fi
    # 3. disabled by config
    if [ -z "$DATASTORE_CRONFILE" ]; then
        return 2
    fi
    return 0
}
# returns false if cron disabled (with systemd)
enable_cron()
{
    use_cron && sed -i 's/^#*//' "$DATASTORE_CRONFILE"
}
# returns false if cron disabled (with systemd)
disable_cron()
{
    use_cron && sed -i 's/^#*/#/' "$DATASTORE_CRONFILE"
}


is_cron_disabled()
{
    use_cron || return 0

    # Assumes that either no lines are commented or all lines are commented.
    # Also please note, that currently cron file for Datastore has only one line (but some time ago there was more).
    grep -q -E '^#' "$DATASTORE_CRONFILE";
}


main()
{
    # See how we were called.
    EXIT_STATUS=0
    case "$1" in
    start)
        service_or_func start && enable_cron
        ;;
    stop)
        disable_cron
        service_or_func stop
        ;;
    restart)
        service_or_func restart && enable_cron
        ;;
    forcestop)
        disable_cron
        forcestop
        ;;
    forcerestart)
        forcerestart && enable_cron
        ;;
    reload)
        service_or_func restart
        ;;
    condstart)
        service_or_func start
        ;;
    condstop)
        service_or_func stop
        ;;
    condrestart)
        service_or_func restart
        ;;
    condreload)
        service_or_func restart
        ;;
    initdb)
        initdb
        ;;
    enable_cron)
        enable_cron
        ;;
    disable_cron)
        disable_cron
        ;;
    *)
        echo "Usage: $0 {start|stop|status|restart|forcestop|forcerestart|reload|condstart|condstop|condrestart|condreload|initdb}"
        exit 2
        ;;
    esac

    exit $EXIT_STATUS
}


status()
{
    ${DATASTORE_GENERIC_PROGRAM} status --pid-path "${DATASTORE_PIDDIR}"
}


# Running commands without need of locking
case "$1" in
status)
    status
    exit 0
    ;;
esac


(
    if $FLOCK -n 9; then
        main "$@"
    else
        echo "Init script is already running" && exit 1
    fi
) 9> $LOCKFILE
