<datastore>
    <!-- Native interface with TLS.
         You have to configure certificate to enable this interface.
         See the openSSL section below.
    -->
    <tcp_port_secure>9440</tcp_port_secure>

    <!-- Used with https_port and tcp_port_secure. Full ssl options list: https://github.com/ClickHouse-Extras/poco/blob/master/NetSSL_OpenSSL/include/Poco/Net/SSLManager.h#L71 -->
    <openSSL replace="replace">
        <server> <!-- Used for https server AND secure tcp port -->
            <certificateFile>/etc/datastore-server/config.d/self-cert.pem</certificateFile>
            <privateKeyFile>/etc/datastore-server/config.d/self-key.pem</privateKeyFile>
            <caConfig>/etc/datastore-server/config.d/ca-cert.pem</caConfig>
            <verificationMode>none</verificationMode>
        </server>
    </openSSL>
</datastore>
