<datastore>
    <logger>
        <log>/var/log/datastore-server/log.log</log>
        <errorlog>/var/log/datastore-server/datastore-server.err.log</errorlog>
        <stderr>/var/log/datastore-server/stderr.log</stderr>
        <stdout>/var/log/datastore-server/stdout.log</stdout>
    </logger>

    <tcp_port>9000</tcp_port>
    <listen_host>127.0.0.1</listen_host>

    <path>/var/lib/datastore/</path>

    <users_config>users.xml</users_config>
</datastore>
