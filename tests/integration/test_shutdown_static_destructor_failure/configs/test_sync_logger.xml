<datastore>
    <logger>
        <level>trace</level>
        <log>/var/log/datastore-server/log.log</log>
        <errorlog>/var/log/datastore-server/log.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
        <stderr>/var/log/datastore-server/stderr.log</stderr>
        <stdout>/var/log/datastore-server/stdout.log</stdout>
        <async>false</async>
    </logger>
</datastore>