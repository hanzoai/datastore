#!/usr/bin/env bash

function test_variant {
    perl -E "say \$_ for map {chomp; (qq{$1})} qx{$DATASTORE_CLIENT -q 'SELECT name FROM system.functions ORDER BY name;'}" | $DATASTORE_CLIENT --calculate_text_stack_trace=0 --compile_expressions=0 --compile_aggregate_expressions=0 -n --ignore-error >/dev/null 2>&1
    $DATASTORE_CLIENT -q "SELECT 'Still alive'"
}

