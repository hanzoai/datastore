#!/usr/bin/env bash
# Tags: no-fasttest

CURDIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../shell_config.sh
. "$CURDIR"/../shell_config.sh

format=$1

${DATASTORE_CLIENT} --query "DROP TABLE IF EXISTS file"
${DATASTORE_CLIENT} --query "CREATE TABLE file (x UInt64) ENGINE = File($format, '${DATASTORE_DATABASE}/data.$format.lz4')"
for size in 10000 100000 1000000 2500000
do
    ${DATASTORE_CLIENT} --query "TRUNCATE TABLE file"
    ${DATASTORE_CLIENT} --query "INSERT INTO file SELECT * FROM numbers($size)"
    ${DATASTORE_CLIENT} --query "SELECT max(x) FROM file"
done

${DATASTORE_CLIENT} --query "DROP TABLE file"
