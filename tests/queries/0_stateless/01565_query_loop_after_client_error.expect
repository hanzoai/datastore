#!/usr/bin/expect -f

# This is a separate test, because we want to test the interactive mode.
# https://github.com/ClickHouse/Datastore/issues/19353

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(DATASTORE_TMP)]} {
    set DATASTORE_TMP $env(DATASTORE_TMP)
} else {
    set DATASTORE_TMP "."
}
exp_internal -f $DATASTORE_TMP/$basename.debuglog 0
set history_file $DATASTORE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; \$DATASTORE_CLIENT_BINARY \$DATASTORE_CLIENT_EXPECT_OPT -m --history_file=$history_file"
expect "\n:) "

send -- "DROP TABLE IF EXISTS t01565;\r"
expect "\nOk."
expect "\n:)"

send -- "CREATE TABLE t01565 (c0 String, c1 Int32) ENGINE = Memory() ;\r"
expect "\nOk."
expect "\n:) "

send -- "INSERT INTO t01565(c0, c1) VALUES (\"1\",1) ;\r"
expect "\n:) "

send -- "INSERT INTO t01565(c0, c1) VALUES ('1', 1) ;\r"
expect "\nOk."
expect "\n:) "

# Ctrl+D
send -- "\4"
expect eof
